          "stringUnit" : {
            "state" : "translated",
            "value" : "Το περιεχόμενο διαβάζεται εύκολα ακόμη και με αυξημένη αντίθεση ή δυσκολία στη διάκριση χρωμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
