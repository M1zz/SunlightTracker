          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビタミンD"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비타민D"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витамин D"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "维生素D"
          }
