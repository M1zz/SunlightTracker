    "같이 받으면 꽃잎이 알록달록 물들고, 친구 탭에 함께한 기록이 남아요." : {
      "comment" : "DashboardView.swift:101",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se budete slunit spolu, okvětní lístky se zbarví do pestrých barev a společné chvíle se zapíšou na kartu Kamarádi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når I soler jer sammen, får blomsterbladene farver, og jeres tid sammen bliver gemt under Venner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsam in der Sonne färben sich die Blütenblätter bunt, und im Freunde-Tab landet euer gemeinsamer Eintrag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν λιαστείτε μαζί, τα πέταλα παίρνουν χρώματα και η στιγμή αποθηκεύεται στην καρτέλα Φίλοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun together and your petals turn colorful, with the time saved in your Friends tab."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share the sun and your petals turn colourful, with your time together saved in the Friends tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si toman el sol juntos, los pétalos se llenan de color y el momento queda guardado en la pestaña Amigos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdessä auringossa terälehdet värjäytyvät kirjaviksi, ja yhteiset hetket tallentuvat Ystävät-välilehdelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez le soleil ensemble : les pétales se colorent et vos moments partagés s’affichent dans l’onglet Amis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau berjemur bareng, kelopakmu jadi berwarna-warni dan catatannya tersimpan di tab Teman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendendo il sole insieme, i petali si tingono di mille colori e nella scheda Amici resta il ricordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いっしょに浴びると花びらがカラフルに染まり、友だちタブに思い出が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같이 받으면 꽃잎이 알록달록 물들고, 친구 탭에 함께한 기록이 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dere soler dere sammen, får kronbladene fine farger, og turen havner i vennefanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonnen jullie samen, dan kleuren je bloemblaadjes vrolijk en komt er een herinnering in het tabblad Vrienden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy łapiecie słońce razem, płatki mienią się kolorami, a wspólne chwile zapisują się w zakładce Znajomi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomando sol juntos, as pétalas ganham cores e o registro fica guardado na aba Amigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы вместе на солнце, лепестки раскрашиваются в яркие цвета, а совместные встречи сохраняются во вкладке «Друзья»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solar ni ihop färgas kronbladen i fina färger, och ert sällskap sparas under fliken Vänner."
