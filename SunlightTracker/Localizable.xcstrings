        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรับแสงธรรมชาติ 30 นาทีช่วยให้หลับเร็วขึ้น 23 นาที ส่วนผู้ที่นอนไม่หลับ รับแดด 60 นาทีช่วยให้นอนนานขึ้น 51 นาที"
