    "60분의 자연광 노출은 불면증 환자의 수면시간을 51분 증가시키고, 혈압을 11% 감소시킵니다." : {
      "comment" : "SunlightManager.swift:637 — 인자 없는 문자열이라 키·값의 % 는 하나로 쓴다(%% 이면 런타임 키가 안 맞아 번역이 안 뜬다)",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minut přirozeného světla prodlouží lidem s nespavostí spánek o 51 minut a sníží krevní tlak o 11%."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutters naturligt lys giver personer med søvnløshed 51 minutters mere søvn og sænker blodtrykket med 11%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 Minuten natürliches Licht verlängern bei Schlafstörungen die Schlafdauer um 51 Minuten und senken den Blutdruck um 11%."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 λεπτά φυσικού φωτός αυξάνουν τον ύπνο των ατόμων με αϋπνία κατά 51 λεπτά και μειώνουν την πίεση κατά 11%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutes of natural light adds 51 minutes of sleep for people with insomnia and lowers blood pressure by 11%."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutes of natural light adds 51 minutes of sleep for people with insomnia and lowers blood pressure by 11%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutos de luz natural aumentan 51 minutos el tiempo de sueño en personas con insomnio y reducen la presión arterial un 11%."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minuuttia luonnonvaloa pidentää unettomien untaa 51 minuutilla ja laskee verenpainetta 11 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 min de lumière naturelle allongent le sommeil des insomniaques de 51 min et réduisent la tension de 11 %."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan cahaya alami 60 menit menambah durasi tidur penderita insomnia 51 menit dan menurunkan tekanan darah 11%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minuti di luce naturale fanno dormire 51 minuti in più chi soffre di insonnia e abbassano la pressione dell'11%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60分の自然光で、不眠症の方の睡眠時間が51分増え、血圧が11%下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60분의 자연광 노출은 불면증 환자의 수면시간을 51분 증가시키고, 혈압을 11% 감소시킵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutter med naturlig lys gir 51 minutter mer søvn ved søvnløshet og senker blodtrykket med 11%."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minuten natuurlijk licht verlengen de slaaptijd bij slapeloosheid met 51 minuten en verlagen de bloeddruk met 11%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minut naturalnego światła wydłuża sen osób z bezsennością o 51 minut i obniża ciśnienie krwi o 11%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minutos de luz natural aumentam em 51 minutos o sono de quem tem insônia e reduzem a pressão arterial em 11%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 минут естественного света увеличивают сон при бессоннице на 51 минуту и снижают давление на 11%."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 minuter naturligt ljus ger 51 minuter mer sömn vid sömnlöshet och sänker blodtrycket med 11%."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรับแสงธรรมชาติ 60 นาทีช่วยให้ผู้ที่นอนไม่หลับนอนนานขึ้น 51 นาที และลดความดันโลหิตลง 11%"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 dakikalık doğal ışık, uykusuzluk çekenlerde uyku süresini 51 dakika uzatır ve tansiyonu %11 azaltır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 phút tiếp xúc ánh sáng tự nhiên giúp người mất ngủ ngủ thêm 51 phút và giảm huyết áp 11%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60分钟的自然光照射，可使失眠者的睡眠时间增加51分钟，血压下降11%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曬 60 分鐘自然光，可讓失眠者的睡眠時間增加 51 分鐘，並使血壓下降 11%。"
          }
        }
      }
    },
