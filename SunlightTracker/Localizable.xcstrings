            "value" : "Tắm nắng cùng nhau, cánh hoa sẽ nhuộm nhiều sắc màu và lần gặp gỡ được lưu ở tab Bạn bè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
