        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słońce pobudza wydzielanie serotoniny i łagodzi objawy depresji. Ponad 30 minut słońca dziennie skutecznie pomaga w leczeniu depresji sezonowej (SAD)."
          }
