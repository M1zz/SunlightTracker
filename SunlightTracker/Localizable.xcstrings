        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinar matahari menambah porsi tidur nyenyak (tidur REM). Jika cukup terpapar sinar matahari di siang hari, kualitas tidur malam meningkat 30%."
