            "value" : "30 minuten natuurlijk licht laat je 23 minuten eerder in slaap vallen. Bij mensen met slapeloosheid verlengt 60 minuten zonlicht de slaaptijd met 51 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
