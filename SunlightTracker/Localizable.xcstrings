    "Siri에게 물으면 오늘 쬔 햇빛 시간을 바로 알려 줘요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptej se Siri a hned ti řekne, kolik času na slunci dnes máš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg Siri, så fortæller hun dig, hvor meget sol du har fået i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag Siri, und sie sagt dir, wie viel Sonne du heute hattest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρώτα τη Siri και θα σου πει αμέσως πόση ώρα λιάστηκες σήμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri how much sunlight you’ve had today."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri how much sunlight you’ve had today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale a Siri y te dirá al momento cuánto sol has tomado hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy Sirilta, niin saat heti tietää, kuinka paljon aurinkoa olet saanut tänään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à Siri combien de soleil tu as pris aujourd’hui, il te répond tout de suite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya Siri, dan kamu langsung tahu berapa lama berjemur hari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Siri e ti dice subito quanto sole hai preso oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに聞くと、今日浴びた日ざしの時間をすぐに教えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 물으면 오늘 쬔 햇빛 시간을 바로 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør Siri, så får du vite hvor mye sol du har fått i dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag het aan Siri en je hoort meteen hoeveel zon je vandaag hebt gehad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj Siri, a od razu powie, ile słońca masz dziś na koncie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte à Siri e ela diz na hora quanto sol você tomou hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите Siri, и она сразу скажет, сколько солнца вы получили сегодня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga Siri så får du direkt veta hur länge du solat i dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถาม Siri แล้วจะบอกเวลาแดดที่ได้รับวันนี้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri'ye sorarsan bugün aldığın güneş süresini hemen söyler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi Siri là biết ngay hôm nay bạn đã tắm nắng bao lâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
