    },
    "비타민D는 근육 기능과 회복에 필수적입니다. 운동 전후 햇빛 노출은 근육통을 줄이고 회복 속도를 높입니다." : {
      "comment" : "Models.swift:266",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D je nezbytný pro funkci svalů a regeneraci. Slunění před cvičením i po něm zmírňuje svalovou bolest a urychluje zotavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamin er afgørende for muskelfunktion og restitution. Sol før og efter træning kan mindske muskelømhed og give hurtigere restitution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D ist wichtig für Muskelfunktion und Regeneration. Sonne vor oder nach dem Sport lindert Muskelkater und beschleunigt die Erholung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βιταμίνη D είναι απαραίτητη για τη λειτουργία και την αποκατάσταση των μυών. Ο ήλιος πριν ή μετά την άσκηση μειώνει τους μυϊκούς πόνους και επιταχύνει την ανάρρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D is essential for muscle function and recovery. Sun before or after exercise eases muscle soreness and speeds up recovery."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D is essential for muscle function and recovery. Sun exposure before or after exercise eases muscle soreness and speeds up recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamina D es esencial para la función y la recuperación muscular. Tomar el sol antes o después de entrenar reduce las agujetas y acelera la recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamiini on välttämätön lihasten toiminnalle ja palautumiselle. Auringonvalo ennen treeniä tai sen jälkeen vähentää lihaskipua ja nopeuttaa palautumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamine D est essentielle à la fonction musculaire et à la récupération. S’exposer au soleil avant ou après le sport réduit les courbatures et accélère la récupération."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D penting untuk fungsi dan pemulihan otot. Terpapar sinar matahari sebelum atau sesudah olahraga mengurangi nyeri otot dan mempercepat pemulihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamina D è essenziale per la funzione e il recupero dei muscoli. Il sole prima o dopo l'allenamento riduce i dolori muscolari e accelera il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビタミンDは、筋肉の働きと回復に欠かせません。運動の前後に日光を浴びると、筋肉痛が和らぎ、回復が早まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비타민D는 근육 기능과 회복에 필수적입니다. 운동 전후 햇빛 노출은 근육통을 줄이고 회복 속도를 높입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D er viktig for muskelfunksjon og restitusjon. Sol før og etter trening gir mindre muskelsmerter og raskere restitusjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamine D is onmisbaar voor spierfunctie en herstel. Zonlicht voor of na het sporten vermindert spierpijn en versnelt het herstel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witamina D jest niezbędna dla pracy mięśni i regeneracji. Słońce przed treningiem i po nim zmniejsza bóle mięśni i przyspiesza regenerację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vitamina D é essencial para a função e a recuperação dos músculos. Tomar sol antes ou depois do exercício reduz a dor muscular e acelera a recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витамин D необходим для работы и восстановления мышц. Солнце до и после тренировки уменьшает мышечную боль и ускоряет восстановление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamin är avgörande för muskelfunktion och återhämtning. Sol före och efter träning minskar träningsvärk och ger snabbare återhämtning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิตามินดีจำเป็นต่อการทำงานและการฟื้นตัวของกล้ามเนื้อ การรับแดดก่อนหรือหลังออกกำลังกายช่วยลดอาการปวดเมื่อยและฟื้นตัวเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D vitamini kas işlevi ve toparlanma için şarttır. Egzersiz öncesi ve sonrası güneş ışığı kas ağrısını azaltır, toparlanmayı hızlandırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D rất cần cho chức năng và quá trình phục hồi của cơ. Tắm nắng trước hoặc sau khi tập giúp giảm đau cơ và hồi phục nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "维生素D对肌肉功能和恢复至关重要。运动前后晒晒太阳，能减轻肌肉酸痛、加快恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維生素 D 對肌肉功能與恢復不可或缺。運動前後曬曬太陽，能減輕肌肉痠痛、加快恢復。"
          }
        }
      }
    },
    "비타민D는 면역세포를 활성화하여 감염 예방에 도움을 줍니다. 충분한 비타민D 수치는 감기와 독감 발생률을 40% 낮춥니다." : {
      "comment" : "Models.swift:271 — 인자 없는 문자열이라 키·값의 % 는 하나로 쓴다(%% 이면 런타임 키가 안 맞아 번역이 안 뜬다)",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D aktivuje imunitní buňky a pomáhá předcházet infekcím. Dostatečná hladina vitaminu D snižuje výskyt nachlazení a chřipky o 40%."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamin aktiverer immuncellerne og hjælper med at forebygge infektioner. Et tilstrækkeligt D-vitaminniveau sænker forekomsten af forkølelse og influenza med 40%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D aktiviert Immunzellen und hilft, Infektionen vorzubeugen. Ein ausreichender Vitamin-D-Spiegel senkt die Häufigkeit von Erkältungen und Grippe um 40%."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βιταμίνη D ενεργοποιεί τα ανοσοκύτταρα και βοηθά στην πρόληψη λοιμώξεων. Επαρκή επίπεδα βιταμίνης D μειώνουν τη συχνότητα κρυολογήματος και γρίπης κατά 40%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D activates immune cells and helps protect against infection. Healthy vitamin D levels lower the rate of colds and flu by 40%."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D activates immune cells and helps protect against infection. Healthy vitamin D levels lower the rate of colds and flu by 40%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamina D activa las células inmunitarias y ayuda a prevenir infecciones. Con niveles suficientes, los resfriados y la gripe se reducen un 40%."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamiini aktivoi immuunisoluja ja auttaa torjumaan infektioita. Riittävä D-vitamiinitaso vähentää flunssan ja influenssan esiintyvyyttä 40 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamine D active les cellules immunitaires et aide à prévenir les infections. Un bon taux de vitamine D réduit de 40 % l’incidence du rhume et de la grippe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D mengaktifkan sel imun sehingga membantu mencegah infeksi. Kadar vitamin D yang cukup menurunkan kejadian flu dan pilek hingga 40%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitamina D attiva le cellule immunitarie e aiuta a prevenire le infezioni. Livelli adeguati di vitamina D riducono del 40% l'incidenza di raffreddore e influenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビタミンDは免疫細胞を活性化し、感染症の予防に役立ちます。ビタミンDが十分だと、風邪やインフルエンザの発症率が40%下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비타민D는 면역세포를 활성화하여 감염 예방에 도움을 줍니다. 충분한 비타민D 수치는 감기와 독감 발생률을 40% 낮춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D aktiverer immuncellene og hjelper mot infeksjoner. Nok vitamin D senker forekomsten av forkjølelse og influensa med 40%."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamine D activeert afweercellen en helpt infecties voorkomen. Een goede vitamine D-spiegel verlaagt de kans op verkoudheid en griep met 40%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witamina D aktywuje komórki odpornościowe i pomaga chronić przed infekcjami. Odpowiedni jej poziom obniża zachorowalność na przeziębienie i grypę o 40%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vitamina D ativa as células de defesa e ajuda a prevenir infecções. Níveis adequados de vitamina D reduzem a incidência de resfriado e gripe em 40%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витамин D активирует иммунные клетки и помогает предотвращать инфекции. Достаточный уровень витамина D снижает частоту простуды и гриппа на 40%."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-vitamin aktiverar immunceller och hjälper till att förebygga infektioner. Tillräckliga D-vitaminnivåer sänker risken för förkylning och influensa med 40%."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิตามินดีกระตุ้นเซลล์ภูมิคุ้มกันและช่วยป้องกันการติดเชื้อ ระดับวิตามินดีที่เพียงพอช่วยลดโอกาสเป็นหวัดและไข้หวัดใหญ่ลง 40%"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D vitamini bağışıklık hücrelerini harekete geçirerek enfeksiyonlardan korunmaya yardımcı olur. Yeterli D vitamini düzeyi, soğuk algınlığı ve grip görülme oranını %40 düşürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitamin D kích hoạt tế bào miễn dịch, giúp phòng ngừa nhiễm trùng. Đủ vitamin D làm giảm 40% tỷ lệ mắc cảm lạnh và cúm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "维生素D能激活免疫细胞，帮助预防感染。维生素D水平充足，可使感冒和流感的发生率降低40%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維生素 D 能活化免疫細胞，幫助預防感染。維生素 D 濃度充足，感冒與流感的發生率可降低 40%。"
          }
        }
      }
    },
