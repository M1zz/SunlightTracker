    "자연광은 인지 기능과 집중력을 향상시킵니다. 실내에서 일할 때도 창가 자리를 선택하면 업무 효율이 15% 증가합니다." : {
      "comment" : "Models.swift:261 — 인자 없는 문자열이라 키·값의 % 는 하나로 쓴다(%% 이면 런타임 키가 안 맞아 번역이 안 뜬다)",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přirozené světlo zlepšuje kognitivní funkce a soustředění. I když pracuješ uvnitř, místo u okna zvýší pracovní efektivitu o 15%."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturligt lys forbedrer kognitive evner og koncentration. Selv når du arbejder indendørs, øger en plads ved vinduet effektiviteten med 15%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natürliches Licht verbessert Denkvermögen und Konzentration. Auch drinnen steigert ein Platz am Fenster die Arbeitseffizienz um 15%."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το φυσικό φως βελτιώνει τις γνωστικές λειτουργίες και τη συγκέντρωση. Ακόμη και αν δουλεύεις μέσα, μια θέση δίπλα στο παράθυρο αυξάνει την απόδοση κατά 15%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural light sharpens cognition and focus. Even indoors, working by a window boosts productivity by 15%."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural light boosts cognitive function and concentration. Even when working indoors, a seat by the window can raise productivity by 15%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz natural mejora la función cognitiva y la concentración. Incluso si trabajas en interiores, sentarte junto a una ventana aumenta tu productividad un 15%."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luonnonvalo parantaa tiedonkäsittelyä ja keskittymiskykyä. Sisätyössäkin ikkunapaikka lisää työtehoa 15 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière naturelle améliore les fonctions cognitives et la concentration. Même au bureau, une place près de la fenêtre augmente l’efficacité au travail de 15 %."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahaya alami meningkatkan fungsi kognitif dan fokus. Saat bekerja di dalam ruangan pun, memilih tempat dekat jendela dapat meningkatkan efisiensi kerja 15%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luce naturale migliora le funzioni cognitive e la concentrazione. Anche se lavori al chiuso, scegliere un posto vicino alla finestra aumenta l'efficienza del 15%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然光は、認知機能と集中力を高めます。室内で働くときも窓際の席を選ぶと、仕事の効率が15%上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자연광은 인지 기능과 집중력을 향상시킵니다. 실내에서 일할 때도 창가 자리를 선택하면 업무 효율이 15% 증가합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturlig lys bedrer tankevirksomhet og konsentrasjon. Selv når du jobber inne, gir en plass ved vinduet 15% bedre effektivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natuurlijk licht verbetert je denkvermogen en concentratie. Ook als je binnen werkt: een plek bij het raam verhoogt je productiviteit met 15%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturalne światło poprawia funkcje poznawcze i koncentrację. Nawet przy pracy w pomieszczeniu miejsce przy oknie zwiększa wydajność o 15%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz natural melhora a cognição e a concentração. Mesmo trabalhando em ambiente fechado, escolher um lugar junto à janela aumenta a produtividade em 15%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Естественный свет улучшает когнитивные функции и концентрацию. Даже при работе в помещении место у окна повышает продуктивность на 15%."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturligt ljus förbättrar kognitionen och koncentrationen. Även inomhus ökar effektiviteten på jobbet med 15% om du sitter vid ett fönster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงธรรมชาติช่วยเสริมการรับรู้และสมาธิ แม้ทำงานในอาคาร การนั่งริมหน้าต่างก็ช่วยให้ประสิทธิภาพการทำงานเพิ่มขึ้น 15%"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğal ışık bilişsel işlevleri ve odaklanmayı geliştirir. İçeride çalışırken bile pencere kenarını seçmek iş verimini %15 artırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh sáng tự nhiên cải thiện nhận thức và khả năng tập trung. Ngay cả khi làm việc trong nhà, ngồi gần cửa sổ cũng giúp tăng hiệu suất làm việc 15%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然光能提升认知功能和专注力。在室内工作时选靠窗的位置，工作效率可提高15%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然光能提升認知功能與專注力。在室內工作時選擇靠窗的位置，工作效率可提高 15%。"
          }
        }
      }
    },
