      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnenlicht weitet die Blutgefäße und senkt den Blutdruck. 60 Minuten Sonne können den systolischen Blutdruck um 11%% senken."
          }
        },
        "en" : {
