          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 минут естественного света сдвигают время засыпания на 23 минуты раньше. У людей с бессонницей 60 минут на солнце увеличивают сон на 51 минуту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 minuter naturligt ljus gör att du somnar 23 minuter tidigare. Vid sömnlöshet ger 60 minuters solljus 51 minuter mer sömn."
