      }
    },
    "햇빛은 세로토닌 분비를 촉진하여 우울증 증상을 완화합니다. 매일 30분 이상의 햇빛 노출은 계절성 우울증(SAD) 치료에 효과적입니다." : {
      "comment" : "Models.swift:258",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slunce podporuje tvorbu serotoninu a zmírňuje příznaky deprese. Denně 30 a více minut na slunci je účinné při léčbě sezónní deprese (SAD)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollys fremmer udskillelsen af serotonin og lindrer symptomer på depression. Mindst 30 minutters sol hver dag er effektivt mod sæsonbetinget depression (SAD)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnenlicht fördert die Ausschüttung von Serotonin und lindert depressive Symptome. Täglich mehr als 30 Minuten Sonne sind wirksam bei saisonal bedingter Depression (SAD)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ήλιος διεγείρει την έκκριση σεροτονίνης και ανακουφίζει από συμπτώματα κατάθλιψης. Η έκθεση πάνω από 30 λεπτά καθημερινά είναι αποτελεσματική στη θεραπεία της εποχικής κατάθλιψης (SAD)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunlight boosts serotonin, which eases symptoms of depression. 30 or more minutes of sun a day is effective for treating seasonal affective disorder (SAD)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunlight boosts serotonin and eases symptoms of depression. At least 30 minutes of sun a day is effective for treating seasonal affective disorder (SAD)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sol estimula la serotonina y alivia los síntomas depresivos. Más de 30 minutos de sol al día son eficaces para tratar la depresión estacional (TAE)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auringonvalo lisää serotoniinin eritystä ja lievittää masennusoireita. Yli 30 minuuttia auringonvaloa päivittäin tehoaa kausittaisen masennuksen (SAD) hoidossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soleil stimule la sécrétion de sérotonine et atténue les symptômes dépressifs. Plus de 30 min de soleil par jour sont efficaces contre la dépression saisonnière (SAD)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinar matahari memacu produksi serotonin sehingga gejala depresi mereda. Paparan sinar matahari lebih dari 30 menit setiap hari efektif untuk mengatasi depresi musiman (SAD)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sole stimola la produzione di serotonina e allevia i sintomi della depressione. Almeno 30 minuti di sole al giorno sono efficaci nel trattamento della depressione stagionale (SAD)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光はセロトニンの分泌を促し、うつ症状をやわらげます。毎日30分以上の日光は、季節性うつ(SAD)の治療に効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇빛은 세로토닌 분비를 촉진하여 우울증 증상을 완화합니다. 매일 30분 이상의 햇빛 노출은 계절성 우울증(SAD) 치료에 효과적입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollys fremmer utskillelsen av serotonin og lindrer depressive symptomer. Minst 30 minutter sol hver dag virker mot årstidsbetinget depresjon (SAD)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonlicht stimuleert de aanmaak van serotonine en verlicht zo depressieve klachten. Elke dag minimaal 30 minuten zon werkt goed bij een winterdepressie (SAD)."
