        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงธรรมชาติกระตุ้นสารสื่อประสาทที่ควบคุมอารมณ์ เพียงรับแดด 15-20 นาทีก็รู้สึกถึงอารมณ์ที่ดีขึ้นได้"
