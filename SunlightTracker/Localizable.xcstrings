        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν λιάζεσαι κοντά σε φίλο,\nη στιγμή καταγράφεται εδώ αυτόματα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
