          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your history private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your history private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para proteger tus registros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse sovellus Face ID:llä tai Touch ID:llä ja suojaa kirjauksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille l’app avec Face ID ou Touch ID pour protéger tes données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci aplikasi dengan Face ID atau Touch ID untuk menjaga catatanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l'app con Face ID o Touch ID per proteggere i tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
