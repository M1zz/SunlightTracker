<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sunny Sunflower</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sunny Sunflower uses your local network to find friends nearby so you can get sunlight together.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Sunny Sunflower checks how close your friends are so you can get sunlight together.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_suntracker-ni._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.leeo.sunflower</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sunflower</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
