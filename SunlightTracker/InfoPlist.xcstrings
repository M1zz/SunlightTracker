    "NSCameraUsageDescription" : {
      "comment" : "iOS camera permission prompt (NSCameraUsageDescription) — the camera is only used to read ambient brightness via exposure data; no photos are taken or stored",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měří jas okolí a podle něj automaticky pozná a zapíše, kolik slunce opravdu dostáváš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen aflæser omgivelsernes lysstyrke for automatisk at registrere din soltid. Der tages eller gemmes ingen billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera misst nur die Umgebungshelligkeit, um echtes Sonnenlicht automatisch zu erkennen und festzuhalten. Es werden keine Fotos aufgenommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα μετράει τη φωτεινότητα του χώρου, ώστε να εντοπίζεται και να καταγράφεται αυτόματα η έκθεσή σου στον ήλιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunny Sunflower reads the brightness around you through the camera to detect and log your real sun exposure automatically. No photos are taken or saved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures the brightness around you to detect and log your real sunlight exposure automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa solo para medir la luz ambiental y detectar y registrar automáticamente tu exposición al sol. No se toman ni se guardan fotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera mittaa ympäristön kirkkautta, jotta sovellus tunnistaa ja kirjaa auringonvalossa vietetyn ajan automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app mesure la luminosité ambiante pour détecter et enregistrer automatiquement ton exposition réelle au soleil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera dipakai untuk mengukur kecerahan sekitar (tanpa mengambil foto) agar paparan sinar matahari terdeteksi dan tercatat otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera serve solo a misurare la luce dell'ambiente per rilevare e registrare in automatico il tempo passato al sole. Non scatta né salva foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周囲の明るさ(照度)を測り、実際に日ざしを浴びた時間を自動で検出して記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 밝기(조도)를 측정하여 실제 햇빛 노출을 자동으로 감지하고 기록합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet brukes bare til å måle lysstyrken rundt deg, slik at appen automatisk kan oppdage og logge sol. Ingen bilder tas eller lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de camera meet de app alleen de helderheid van je omgeving (lux), zodat je zonlicht automatisch wordt herkend en vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzamy jasność otoczenia, by automatycznie wykrywać i zapisywać Twój czas na słońcu. Aparat służy tylko do pomiaru światła, nie robimy ani nie zapisujemy zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede a luz do ambiente para detectar e registrar automaticamente sua exposição ao sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет яркость вокруг, чтобы автоматически определять и записывать время на солнце."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran mäter ljusstyrkan i omgivningen så att appen automatiskt kan känna av och logga hur länge du solar. Inga foton tas eller sparas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปใช้กล้องวัดความสว่างรอบตัวเพื่อตรวจจับและบันทึกการรับแดดจริงโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortamın parlaklığını (ışık düzeyini) ölçerek güneşte geçirdiğin süreyi otomatik algılar ve kaydeder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunny Sunflower dùng camera để đo độ sáng xung quanh, từ đó tự động nhận biết và ghi lại thời gian bạn tiếp xúc với ánh nắng. Ứng dụng không chụp hay lưu ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过测量周围的亮度（照度），自动识别并记录你实际晒到太阳的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測量周圍的亮度（照度），自動偵測並記錄實際曬太陽的時間。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "iOS location permission prompt (NSLocationWhenInUseUsageDescription)",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poloha je potřeba k výpočtu východu a západu slunce a k přesnému sledování slunění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din position bruges til at beregne solopgang og solnedgang og til at registrere din solskinstid mere præcist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird benötigt, um Sonnenaufgang und -untergang zu berechnen und deine Sonnenzeit genau zu erfassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία χρειάζεται για τον υπολογισμό της ανατολής και της δύσης και για ακριβή καταγραφή της ηλιοφάνειας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to work out sunrise and sunset times and to track your sunlight more accurately."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is needed to work out sunrise and sunset times and to track sunlight accurately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos tu ubicación para calcular la hora del amanecer y el atardecer y registrar con precisión tu exposición al sol."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintia tarvitaan auringonnousun ja -laskun ajankohtien laskemiseen sekä auringonvalon tarkkaan seurantaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position sert à calculer l’heure du lever et du coucher du soleil et à suivre précisément ton ensoleillement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi dibutuhkan untuk menghitung waktu matahari terbit/terbenam dan melacak sinar matahari dengan akurat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione serve per calcolare alba e tramonto e tenere traccia del sole in modo più preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日の出・日の入り時刻の計算と、正確な日照時間の記録のために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일출/일몰 시간 계산과 정확한 일조량 추적을 위해 위치 정보가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjonen din brukes til å beregne soloppgang og solnedgang og til å følge solnivået nøyaktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je locatie is nodig om zonsopkomst en zonsondergang te berekenen en je zonlicht nauwkeurig bij te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja jest potrzebna do obliczania godzin wschodu i zachodu słońca oraz do dokładnego śledzenia czasu na słońcu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisamos da sua localização para calcular o nascer e o pôr do sol e acompanhar o tempo de sol com precisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположение нужно, чтобы рассчитывать время восхода и заката и точнее отслеживать солнце."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din plats behövs för att beräkna soluppgång och solnedgång och för att logga solljuset exakt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ตำแหน่งที่ตั้งเพื่อคำนวณเวลาพระอาทิตย์ขึ้น/ตก และติดตามปริมาณแดดให้แม่นยำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün doğumu/batımı saatlerini hesaplamak ve güneş süreni doğru takip etmek için konum bilgisine ihtiyaç var."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunny Sunflower cần vị trí của bạn để tính giờ mặt trời mọc/lặn và theo dõi thời gian nắng chính xác hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要获取位置信息，以计算日出日落时间并准确记录日照时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用位置資訊，以計算日出／日落時間並精準追蹤日照量。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Health permission: reads Time in Daylight",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načítá čas na denním světle změřený Apple Watch a přičítá ho k dnešnímu slunci. Zdravotní data nikdy neopustí tvoje zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen læser den tid i dagslys, som dit Apple Watch måler, og lægger den til dagens sol. Sundhedsdata forlader aldrig din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die von deiner Apple Watch gemessene Zeit im Tageslicht und rechnet sie zur heutigen Sonne hinzu. Gesundheitsdaten verlassen nie dein Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει τον χρόνο στο φως της μέρας που μετρά το Apple Watch και τον προσθέτει στον σημερινό ήλιο. Τα δεδομένα υγείας δεν φεύγουν ποτέ από τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunny Sunflower reads the time in daylight measured by your Apple Watch and adds it to today’s sunlight. Health data never leaves your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunny Sunflower reads the time in daylight measured by your Apple Watch and adds it to today’s sunlight. Health data never leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el tiempo con luz natural que mide tu Apple Watch y lo suma al sol de hoy. Los datos de salud nunca salen de tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukee Apple Watchin mittaaman päivänvalossa vietetyn ajan ja lisää sen päivän auringonvaloon. Terveystiedot eivät koskaan poistu laitteelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le temps passé à la lumière du jour mesuré par ton Apple Watch et l’ajoute au soleil du jour. Tes données de santé ne quittent jamais ton appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membaca waktu di bawah cahaya siang yang diukur Apple Watch dan menambahkannya ke sinar matahari hari ini. Data kesehatan tidak pernah keluar dari perangkatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge il tempo alla luce del giorno misurato da Apple Watch e lo aggiunge al sole di oggi. I dati sulla salute non lasciano mai il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchが測った「日光下の時間」を読み込み、今日の日ざしに加えます。健康データがデバイスの外に送られることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch가 잰 '햇빛 아래 있었던 시간'을 읽어 오늘 받은 햇빛에 더합니다. 건강 데이터는 기기 밖으로 보내지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leser tiden i dagslys som Apple Watch måler, og legger den til dagens sol. Helsedata forlater aldri enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest de tijd in daglicht die je Apple Watch meet en telt die op bij de zon van vandaag. Gezondheidsgegevens verlaten je apparaat nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje czas w świetle dziennym zmierzony przez Apple Watch i dodaje go do dzisiejszego słońca. Dane o zdrowiu nigdy nie opuszczają urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê o tempo à luz do dia medido pelo Apple Watch e soma ao sol de hoje. Os dados de saúde nunca saem do seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считывает время на дневном свету, измеренное Apple Watch, и добавляет его к сегодняшнему солнцу. Данные о здоровье не покидают устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser tiden i dagsljus som din Apple Watch mäter och lägger till den i dagens sol. Hälsodata lämnar aldrig din enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเวลากลางแจ้งที่ Apple Watch วัดได้ แล้วรวมเข้ากับแดดของวันนี้ ข้อมูลสุขภาพจะไม่ถูกส่งออกนอกอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch’un ölçtüğü gün ışığında geçen süreyi okuyup bugünkü güneşe ekler. Sağlık verileri cihazından asla çıkmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc thời gian dưới ánh sáng ban ngày do Apple Watch đo và cộng vào lượng nắng hôm nay. Dữ liệu sức khỏe không bao giờ rời khỏi thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取 Apple Watch 测得的日光下时间，计入今天的阳光。健康数据绝不会离开你的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取 Apple Watch 測得的日光下時間，計入今天的陽光。健康資料絕不會離開你的裝置。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
